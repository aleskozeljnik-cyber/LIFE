DATABASE_URL=postgresql://postgres:password@host:5432/postgres
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Privacy-safe free/dev provider
AI_PROVIDER=cloudflare
AI_TIMEOUT_SECONDS=20
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/zai-org/glm-4.7-flash

# Gemini: real user data is blocked unless Paid Tier is independently verified.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_PAID_TIER_VERIFIED=false

# OpenRouter: real user data is blocked unless provider data handling is independently verified.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_DATA_USAGE_VERIFIED=false

# Anthropic commercial API defaults to no model training use, unless explicitly opted in.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_DATA_USAGE_VERIFIED=false

TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=change-me
FRONTEND_URL=http://localhost:3000
